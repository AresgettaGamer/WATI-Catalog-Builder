{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wati.example/schema/v3/report.schema.json",
  "title": "WATI Catalog Report v3",
  "type": "object",
  "required": ["schemaVersion", "format", "generatorVersion", "summary", "issues"],
  "properties": {
    "schemaVersion": {"const": 3},
    "format": {"const": "wati.catalog.report"},
    "generatorVersion": {"type": "string"},
    "summary": {
      "type": "object",
      "required": ["items", "blocks", "entities", "recipes", "stations", "acquisition", "errors", "warnings", "info"]
    },
    "packs": {"type": "array"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "code", "message"],
        "properties": {
          "severity": {"enum": ["error", "warning", "info"]},
          "code": {"type": "string"},
          "message": {"type": "string"},
          "path": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "metadataEvidence": {"type": "object"}
  },
  "additionalProperties": true
}
